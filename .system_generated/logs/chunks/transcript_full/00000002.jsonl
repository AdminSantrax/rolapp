com/react@18/umd/react.production.min.js\"></script>\n  <script crossorigin src=\"https://unpkg.com/react-dom@18/umd/react-dom.production.min.js\"></script>\n  <script src=\"https://unpkg.com/@babel/standalone/babel.min.js\"></script>\n  <!-- React Router (UMD) -->\n  <script src=\"https://unpkg.com/react-router-dom@6/umd/react-router-dom.production.min.js\"></script>\n</head>\n<body class=\"bg-dark text-light\">\n  <div id=\"root\"></div>\n\n  <!-- Application code (Babel compiled on the fly) -->\n  <script type=\"text/babel\" data-type=\"module\" src=\"./src/App.jsx\"></script>\n</body>\n</html>\n","Overwrite":true,"Path":"C:/Users/jairo/.gemini/antigravity/brain/b91b810e-928c-493c-ba7f-da11b9e7b0b1/index.html"}}]}
