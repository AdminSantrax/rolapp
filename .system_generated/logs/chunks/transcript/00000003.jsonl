rtifactMetadata":"{\"RequestFeedback\":false,\"Summary\":\"Vite configuration for rolapp\",\"UserFacing\":true}","Content":"\"// vite.config.js\\nimport { defineConfig } from 'vite';\\nimport react from '@vitejs/plugin-react';\\n\\nexport default defineConfig({\\n  plugins: [react()],\\n  base: '/rolapp/', // GitHub Pages base path\\n  build: {\\n    outDir: 'dist',\\n    rollupOptions: {\\n      input: 'index.html',\\n    },\\n  },\\n});\\n\"","Overwrite":"true","Path":"\"C:/Users/jairo/.gemini/antigravity/brain/b91b810e-928c-493c-ba7f-da11b9e7b0b1/vite.config.js\""}}]}
